{
  "name": "connorabdelnoor.github.io",
  "description": "Connor Abdelnoor's personal site, built with Vite and vanilla JavaScript.",
  "version": "2.0.0",
  "type": "module",
  "keywords": [
    "personal-site",
    "vite",
    "vanilla-js",
    "github-pages"
  ],
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "dev": "vite --host --open",
    "lint": "eslint --ext .js ./",
    "lint:fix": "eslint --fix --ext .js ./",
    "format": "prettier --write \"./**/*.{js,jsx,json,css}\"",
    "build": "vite build",
    "preview": "vite preview --open",
    "buildpreview": "vite build && vite preview --open",
    "deploy": "npm run build && gh-pages -d dist",
    "test": "node --test 'vite/**/*.test.js'"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "autoprefixer": "^10.6.2",
    "cssnano": "^9.9.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.7",
    "gh-pages": "^6.3.0",
    "globals": "^17.14.0",
    "postcss": "^8.5.32",
    "postcss-nesting": "^14.0.3",
    "prettier": "^3.9.10",
    "vite": "^8.3.6",
    "vite-plugin-eslint2": "^5.3.0"
  },
  "dependencies": {
    "the-new-css-reset": "^1.11.3"
  }
}
